{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAYBOARD",
  "version": "1.0.0",
  "identifier": "app.dayboard.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DAYBOARD — ваш день под контролем",
        "width": 1240,
        "height": 810,
        "minWidth": 320,
        "minHeight": 440,
        "center": true,
        "backgroundColor": "#10141C",
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Лёгкая Kanban-доска для вашего дня и недели",
    "category": "Productivity"
  }
}
